{
  "name": "ibox-business-knowledge-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test:planning": "node --test tests/planning.test.mjs",
    "test:catalog": "node --test tests/catalog-adapter.test.mjs",
    "test:cta": "node --test tests/cta-destination.test.mjs",
    "test:assistant": "node --test tests/assistant-context.test.mjs",
    "test:workplan": "node --test tests/material-workplan.test.mjs",
    "test:tracking": "node --test tests/tracking-preview.test.mjs",
    "test:data-source-config": "node --test tests/data-source-config.test.mjs",
    "test:data-source-repositories": "node --test tests/data-source-repositories.test.mjs",
    "test:data-source-route-outcome": "node --test tests/data-source-route-outcome.test.mjs",
    "test:data-source-reconciliation": "node --test tests/data-source-reconciliation.test.mjs",
    "test:data-source-security": "node --test tests/data-source-security.test.mjs",
    "test:task-client": "node --test tests/task-client.test.mjs",
    "test:task-client-http-config": "node --test tests/task-client-http-config.test.mjs",
    "test:task-client-http": "node --test tests/task-client-http.test.mjs",
    "test:task-client-http-security": "node --test tests/task-client-http-security.test.mjs",
    "test:content-os-task-backend-signer": "node --test tests/content-os-task-backend-signer.test.mjs",
    "test:task-backend-service-auth-config": "node --test tests/task-backend-service-auth-config.test.mjs",
    "test:task-client-signed-service": "node --test tests/task-client-signed-service.test.mjs",
    "test:task-client-signed-service-security": "node --test tests/task-client-signed-service-security.test.mjs",
    "test:task-type": "node --test tests/task-type.test.mjs",
    "test:workflow-template": "node --test tests/workflow-template.test.mjs",
    "test:workflow-fixtures": "node --test tests/workflow-fixtures.test.mjs",
    "test:content-os-store": "node --test tests/content-os-store.test.mjs",
    "test:task-link": "node --test tests/task-link.test.mjs",
    "test:task-instance": "node --test tests/task-instance.test.mjs",
    "test:workflow-runtime": "node --test tests/workflow-runtime.test.mjs",
    "test:task-runtime-store": "node --test tests/task-runtime-store.test.mjs",
    "test:content-entity": "node --test tests/content-entity.test.mjs",
    "test:content-entity-store": "node --test tests/content-entity-store.test.mjs",
    "test:content-workflow": "node --test tests/content-workflow.test.mjs",
    "test:task-completion": "node --test tests/task-completion.test.mjs",
    "test:distribution": "node --test tests/distribution.test.mjs",
    "test:v1-stabilization": "node --test tests/v1-stabilization.test.mjs",
    "test:head-review": "node --test tests/head-review.test.mjs",
    "test:persistence-adapter": "node --test tests/persistence-adapter.test.mjs",
    "test:blog-review-lineage": "node --test tests/blog-review-lineage.test.mjs",
    "test:blog-review-recovery": "node --test tests/blog-review-recovery.test.mjs",
    "test:material-production": "node --test tests/material-production.test.mjs",
