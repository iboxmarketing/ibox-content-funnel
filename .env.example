GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Data-source feature flag. One of: SHEETS_ONLY (default), DUAL_READ,
# SUPABASE_READ. SUPABASE_WRITE is recognized but always rejected until the
# Supabase schema contract and task-backend write integration are approved.
# Leave unset for the current, unchanged Sheets-only behavior.
DATA_SOURCE=

# Task Bot server origin used by the signed server-only task client.
TASK_BACKEND_BASE_URL=

# Legacy/demonstration auth only -- read by lib/task-client-http-config.ts's
# tests. marketing-team-task-bot has no service-account login (see the
# wire-contract audit's AUTH_GAP), so this would be one specific human's
# short-lived (12h) session cookie, never a durable credential.
TASK_BACKEND_SESSION_COOKIE=

# Signed server-to-server auth. The subject is the current public.users.id
# returned by Content OS Telegram-session validation; Task Bot reloads that
# row and applies its own permissions. Never prefix the secret with
# NEXT_PUBLIC_.
TASK_BACKEND_SERVICE_AUTH_ENABLED=false
CONTENT_OS_TASK_BACKEND_SECRET=

# Standalone Worker authentication + Content OS persistence. Server-only;
# never prefix these with NEXT_PUBLIC_. The service-role key is a Wrangler
# secret in production. The URL and existing bot username are Worker vars.
CONTENT_OS_PERSISTENCE_ENABLED=false
CONTENT_OS_SUPABASE_URL=
CONTENT_OS_SUPABASE_SERVICE_ROLE_KEY=
CONTENT_OS_TELEGRAM_BOT_USERNAME=
