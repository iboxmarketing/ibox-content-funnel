GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Data-source feature flag. One of: SHEETS_ONLY (default), DUAL_READ,
# SUPABASE_READ. SUPABASE_WRITE is recognized but always rejected until the
# Supabase schema contract and task-backend write integration are approved.
# Leave unset for the current, unchanged Sheets-only behavior.
DATA_SOURCE=

# NOT wired into any production code path yet -- read only by
# lib/task-client-http-config.ts's tests. marketing-team-task-bot has no
# service-account login (see the wire-contract audit's AUTH_GAP), so
# TASK_BACKEND_SESSION_COOKIE would be one specific human's short-lived
# (12h) session cookie, never a durable credential. Leave both unset.
TASK_BACKEND_BASE_URL=
TASK_BACKEND_SESSION_COOKIE=
