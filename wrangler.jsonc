{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ibox-content-os",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Public login start is limited per client at the edge (key = SHA-256 of CF-Connecting-IP).
  "ratelimits": [
    { "name": "LOGIN_START_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
